{
  "name": "@workspace/backend",
  "version": "0.0.1",
  "description": "Hono + Hocuspocus backend for Flowpocus real-time collaboration",
  "type": "module",
  "private": true,
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hocuspocus/extension-database": "^3.4.3",
    "@hocuspocus/extension-redis": "^3.4.3",
    "@hocuspocus/server": "^3.4.3",
    "@hono/node-server": "^1.19.9",
    "@hono/node-ws": "^1.1.1",
    "@hono/swagger-ui": "^0.5.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@workspace/commands": "workspace:*",
    "@workspace/database": "workspace:*",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.5",
    "ioredis": "^5.9.2",
    "yjs": "^13.6.29",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3"
  }
}
