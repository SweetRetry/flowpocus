{
  "name": "@workspace/backend",
  "version": "0.0.1",
  "description": "Elysia + Hocuspocus backend on Bun for Flowpocus real-time collaboration",
  "type": "module",
  "private": true,
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun dist/index.js",
    "test": "bun test --parallel",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.3",
    "@elysiajs/openapi": "^1.4.17",
    "@hocuspocus/extension-database": "^4.8.0",
    "@hocuspocus/extension-redis": "^4.8.0",
    "@hocuspocus/server": "^4.8.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@workspace/commands": "workspace:*",
    "@workspace/database": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.32",
    "ioredis": "~5.6.1",
    "lib0": "^0.2.120",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
