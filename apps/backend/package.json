    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hocuspocus/extension-database": "^4.7.1",
    "@hocuspocus/extension-redis": "^4.7.1",
    "@hocuspocus/server": "^4.7.1",
    "@hono/node-server": "^2.1.5",
    "@hono/swagger-ui": "^0.6.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@workspace/commands": "workspace:*",
    "@workspace/database": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "ioredis": "~5.6.1",
    "ws": "^8.22.0",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15"
  }
