{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {},
    "apps/web": {
      "entry": ["app/**/*.{ts,tsx}", "components/**/*.{ts,tsx}", "lib/**/*.ts", "hooks/**/*.ts"],
      "project": ["**/*.{ts,tsx}"],
      "ignore": [".next/**", "out/**"]
    },
    "apps/backend": {
      "project": ["src/**/*.ts"]
    },
    "apps/cli": {
      "project": ["src/**/*.ts"]
    },
    "packages/ui": {
      "entry": ["src/components/*.tsx", "src/lib/*.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/canvas": {
      "entry": [
        "src/components/**/*.tsx",
        "src/hooks/**/*.ts",
        "src/lib/*.ts",
        "src/types/*.ts",
        "src/stores/*.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/database": {
      "project": ["src/**/*.ts"]
    },
    "packages/commands": {
      "project": ["src/**/*.ts"]
    },
    "packages/typescript-config": {}
  },
  "ignore": [
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**",
    "**/out/**",
    "**/target/**",
    "**/*.css"
  ],
  "ignoreDependencies": [
    "@types/.+",
    "@workspace/typescript-config",
    "@tailwindcss/postcss",
    "tailwindcss",
    "postcss",
    "postcss-load-config",
    "@turbo/gen",
    "react-dom"
  ],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "rules": {
    "unresolved": "off"
  }
}
