{
  "name": "@workspace/svelte-canvas",
  "version": "0.0.1",
  "description": "Svelte Flow canvas components and hooks for Flowpocus",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "exports": {
    "./lib/*": "./src/lib/*.ts",
    "./components/*": "./src/components/*.svelte",
    "./components/nodes": "./src/components/nodes/index.ts",
    "./components/plugins": "./src/components/plugins/index.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./stores/*": "./src/stores/*.ts",
    "./types/*": "./src/types/*.ts"
  },
  "dependencies": {
    "@hocuspocus/provider": "^3.4.3",
    "@workspace/svelte-ui": "workspace:*",
    "@xyflow/svelte": "^1.5.0",
    "dompurify": "^3.2.4",
    "lucide-svelte": "^0.508.0",
    "marked": "^12.0.2",
    "yjs": "^13.6.29"
  },
  "devDependencies": {
    "svelte": "^5.0.0",
    "svelte-check": "^4.3.4",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
