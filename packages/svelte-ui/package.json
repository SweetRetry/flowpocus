{
  "name": "@workspace/svelte-ui",
  "version": "0.0.1",
  "description": "Svelte UI components for Flowpocus (shadcn-svelte compatible)",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch"
